NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
WORKER_SECRET=choose-a-long-random-secret
PROVIDER_SECRET_ENCRYPTION_KEY=choose-a-long-random-encryption-key
RESEND_API_KEY=your-resend-api-key
TRANSACTIONAL_EMAIL_FROM=MSGNEX <noreply@your-domain.com>

# SMS provider selection: fake | netgsm
# Production ortaminda bu deger zorunludur. Canli ortamda fake kullanmayin.
SMS_PROVIDER=fake
SMS_PROVIDER_TIMEOUT_MS=15000

# Netgsm server-only credentials.
NETGSM_ENDPOINT=https://api.netgsm.com.tr/sms/send/xml
NETGSM_USERCODE=your-netgsm-usercode
NETGSM_PASSWORD=your-netgsm-password
NETGSM_HEADER=your-sender-id
NETGSM_APPKEY=
NETGSM_ENCODING=TR
